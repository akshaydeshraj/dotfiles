    </dict>

    <dict>
      <key>name</key><string>Invalid</string>
      <key>scope</key><string>invalid, invalid.illegal</string>
      <key>settings</key><dict>
        <key>foreground</key><string>#ff5370</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Shell variable interpolation</string>
      <key>scope</key><string>variable.other.normal.shell, punctuation.definition.variable</string>
      <key>settings</key><dict>
        <key>foreground</key><string>#7dcfff</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
