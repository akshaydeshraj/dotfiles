# Machine-specific secrets — copy to ~/.env and fill in real values
# NEVER commit the real ~/.env file

export BW_SESSION="your-bitwarden-session-token-here"
export HETZNER_IP="0.0.0.0"
export NAS_IP="0.0.0.0"
export GIT_USER_NAME="Your Name"
export GIT_USER_EMAIL="you@example.com"
export SENTRY_AUTH_TOKEN="your-sentry-auth-token-here"
export METAMCP_BEARER_KEY="your-metamcp-bearer-key-here"
export ANTHROPIC_API_KEY="your-anthropic-api-key-here"
export LLM_API_KEY="your-llm-api-key-here"
